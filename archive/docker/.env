HOST_UID=1000
HOST_GID=111

ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp


# ============================================================
# Fast DDS Discovery Server
# ============================================================

# 1 = this container runs its own discovery server and points every node at
#     it (see ros_env.sh). 0 = plain DDS multicast discovery, no server.
#
# OFF (2026-09-21). The rover is meant to run self-contained on the Jetson,
# and a discovery server buys nothing here: it exists to give remote peers a
# fixed rendezvous point, and there is no longer a remote peer in the
# topology (TURTLEBOT4_DISCOVERY_IP below is empty). What it did cost was a
# failure mode -- a discovery-server *client* routes ALL of its discovery
# through the configured servers, so if the server is not up, or is up but
# at a stale address, a node cannot discover others even on its own machine.
# Plain multicast has no such dependency.
#
# This is the only switch: /entrypoint.sh and the ~/.bashrc line both call
# ros_discovery_server_start, which is a no-op unless this is 1, and
# ros_env.sh leaves ROS_DISCOVERY_SERVER / ROS_SUPER_CLIENT unset.
#
# Discovery still reaches the LAN -- ROS_LOCALHOST_ONLY stays 0 in
# compose.yaml, so a laptop on the same wifi and ROS_DOMAIN_ID can still run
# rviz2 / rqt / `ros2 topic echo` against the rover. Set that to 1 instead if
# you want DDS traffic to stay on the Jetson entirely.
ROS_DISCOVERY_SERVER_ENABLE=0

ROS_DISCOVERY_PORT=11811

# Always True here, not just for interactive shells: launch files and
# background nodes need full discovery visibility too, not only terminals.
ROS_SUPER_CLIENT=True

# The TurtleBot 4's own discovery server, added as server id 8 to match
# /etc/turtlebot4_discovery/setup.bash on the robot. Leave EMPTY if the
# robot is instead pointed at this Jetson's server (the simpler topology --
# run `ros_discovery_peer_config` in the container to get its settings).
#
# Accepts a HOSTNAME as well as an IP, and resolves it at container start.
# Prefer the hostname: this Jetson moves between networks, and the robot
# gets a different DHCP address on each one, while its name does not change.
# The name has to be resolvable from inside the container (router DNS or
# /etc/hosts); .local/mDNS names need nss-mdns, which the image does not
# install. A name that does not resolve is reported and dropped rather than
# left in place, since a server entry that never answers still gets
# discovery traffic routed to it.
#
# The previous value here, 192.168.8.187, was on a subnet this Jetson is no
# longer attached to.
TURTLEBOT4_DISCOVERY_IP=
