<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aprilgrid_ground_calibrator</name>
  <version>1.0.0</version>
  <description>
    Calibrates camera height above the ground and camera downward tilt
    angle using a planar AprilGrid target placed flat on the floor. Fuses
    all visible AprilTag corners into a single joint PnP pose estimate of
    the whole board (no per-tag pose averaging), then aggregates many
    stationary frames with robust statistics.
  </description>
  <maintainer email="vaishnavr27@gmail.com">vaishnavr27</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!--
    pupil_apriltags (pip install pupil-apriltags) is the preferred AprilTag
    detector and is NOT a rosdep/apt package, so it is intentionally not
    declared here. See the package README / install instructions.

    apriltag_msgs is only needed if you run with
    detection_source:=apriltag_ros (optional external-detector mode) and is
    imported defensively (try/except) so its absence does not break the
    default "internal" detection mode.
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
