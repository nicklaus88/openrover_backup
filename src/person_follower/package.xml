<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>person_follower</name>
  <version>0.0.1</version>
  <description>
    Monocular(+depth) person-detection, tracking and following for
    TurtleBot4/OAK-D, in the spirit of koide3/monocular_person_following:
    pose detection (YOLO-Pose) -&gt; tracking (Kalman filter) -&gt; a
    SEARCH/TRACKING/LOST/REACQUIRE state machine with lightweight
    appearance re-id -&gt; a proportional cmd_vel controller.
  </description>
  <maintainer email="vaishnavr27@gmail.com">robopi</maintainer>
  <license>BSD</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>person_follower_msgs</depend>

  <exec_depend>depthai_ros_driver</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
